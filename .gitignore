# Dependencies
node_modules/

# Rust / Tauri build output
src-tauri/target/
# Tauri 构建期生成的能力 schema（Cargo.lock 则要入库）
src-tauri/gen/schemas/

# Release build workspace (separate packaging directory, caches included)
DSHManagerRelease/

# Downloaded/extracted releases (never commit the packaged app)
ReleaseDownload/

# electron-builder output (CI / manual builds)
release/

# Logs and runtime artifacts
*.log
crash.log
npm-debug.log*

# Git credentials (never commit)
.git-credentials
.git-credentials-*

# OS / editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
